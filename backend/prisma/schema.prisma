// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [citext]
}

enum Role {
  admin
  teacher
  student
  parent
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  sectionId    String?
  section      Section? @relation("StudentSection", fields: [sectionId], references: [id], onDelete: SetNull)

  refreshTokens        RefreshToken[]
  passwordResets       PasswordResetToken[]
  classTeacherSections Section[]            @relation("SectionClassTeacher")
  taughtClassSubjects  ClassSubject[]       @relation("SubjectTeacher")
  timetableEntries     TimetableEntry[]     @relation("EntryTeacher")

  @@index([sectionId])
}

model RefreshToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  longLived Boolean   @default(false)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Class {
  id        String   @id @default(cuid())
  name      String   @unique @db.Citext
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sections      Section[]
  classSubjects ClassSubject[]
}

model Section {
  id             String   @id @default(cuid())
  name           String   @db.Citext
  classId        String
  class          Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  classTeacherId String?
  classTeacher   User?    @relation("SectionClassTeacher", fields: [classTeacherId], references: [id], onDelete: SetNull)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  students       User[]   @relation("StudentSection")

  timetableEntries TimetableEntry[]

  @@unique([classId, name])
  @@index([classTeacherId])
}

model Subject {
  id        String   @id @default(cuid())
  name      String   @unique @db.Citext
  createdAt DateTime @default(now())

  classSubjects    ClassSubject[]
  timetableEntries TimetableEntry[]
}

model ClassSubject {
  id        String  @id @default(cuid())
  classId   String
  class     Class   @relation(fields: [classId], references: [id], onDelete: Cascade)
  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id])
  teacherId String?
  teacher   User?   @relation("SubjectTeacher", fields: [teacherId], references: [id], onDelete: SetNull)

  @@unique([classId, subjectId])
  @@index([subjectId])
  @@index([teacherId])
}

model Period {
  id        String  @id @default(cuid())
  order     Int     @unique
  startTime String
  endTime   String
  isBreak   Boolean @default(false)
  label     String?

  timetableEntries TimetableEntry[]
}

enum DayOfWeek {
  mon
  tue
  wed
  thu
  fri
}

model TimetableEntry {
  id        String    @id @default(cuid())
  sectionId String
  section   Section   @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  periodId  String
  period    Period    @relation(fields: [periodId], references: [id])
  dayOfWeek DayOfWeek
  subjectId String
  subject   Subject   @relation(fields: [subjectId], references: [id])
  teacherId String
  teacher   User      @relation("EntryTeacher", fields: [teacherId], references: [id])

  @@unique([sectionId, periodId, dayOfWeek])
  @@index([periodId])
  @@index([subjectId])
  @@index([teacherId])
}
