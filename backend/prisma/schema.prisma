// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [citext]
}

enum Role {
  admin
  teacher
  student
  parent
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  sectionId    String?
  section      Section? @relation("StudentSection", fields: [sectionId], references: [id], onDelete: SetNull)

  // Profile fields. Which ones apply depends on the role (see backend/src/people).
  phone         String?
  gender        String?
  address       String?
  employeeId    String?   @unique
  department    String?
  joiningDate   DateTime? @db.Date
  dateOfBirth   DateTime? @db.Date
  rollNumber    String?
  admissionDate DateTime? @db.Date
  relationship  String?
  parentId      String?
  parent        User?     @relation("ParentChildren", fields: [parentId], references: [id], onDelete: SetNull)
  children      User[]    @relation("ParentChildren")

  refreshTokens         RefreshToken[]
  passwordResets        PasswordResetToken[]
  classTeacherSections  Section[]            @relation("SectionClassTeacher")
  taughtClassSubjects   ClassSubject[]       @relation("SubjectTeacher")
  timetableEntries      TimetableEntry[]     @relation("EntryTeacher")
  attendanceSubmissions AttendanceSession[]  @relation("AttendanceSubmitter")
  attendanceEntries     AttendanceEntry[]    @relation("StudentAttendance")
  attendanceEditsOnMe   AttendanceEdit[]     @relation("AttendanceEditedStudent")
  attendanceEditsByMe   AttendanceEdit[]     @relation("AttendanceEditedBy")
  notices               Notice[]

  @@unique([sectionId, rollNumber])
  @@index([sectionId])
  @@index([parentId])
}

model RefreshToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  longLived Boolean   @default(false)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Class {
  id        String   @id @default(cuid())
  name      String   @unique @db.Citext
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sections      Section[]
  classSubjects ClassSubject[]
  notices       Notice[]
}

model Section {
  id             String   @id @default(cuid())
  name           String   @db.Citext
  classId        String
  class          Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  classTeacherId String?
  classTeacher   User?    @relation("SectionClassTeacher", fields: [classTeacherId], references: [id], onDelete: SetNull)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  students       User[]   @relation("StudentSection")

  timetableEntries   TimetableEntry[]
  attendanceSessions AttendanceSession[]

  @@unique([classId, name])
  @@index([classTeacherId])
}

model Subject {
  id        String   @id @default(cuid())
  name      String   @unique @db.Citext
  createdAt DateTime @default(now())

  classSubjects    ClassSubject[]
  timetableEntries TimetableEntry[]
}

model ClassSubject {
  id        String  @id @default(cuid())
  classId   String
  class     Class   @relation(fields: [classId], references: [id], onDelete: Cascade)
  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id])
  teacherId String?
  teacher   User?   @relation("SubjectTeacher", fields: [teacherId], references: [id], onDelete: SetNull)

  @@unique([classId, subjectId])
  @@index([subjectId])
  @@index([teacherId])
}

model Period {
  id        String  @id @default(cuid())
  order     Int     @unique
  startTime String
  endTime   String
  isBreak   Boolean @default(false)
  label     String?

  timetableEntries TimetableEntry[]
}

enum DayOfWeek {
  mon
  tue
  wed
  thu
  fri
}

model TimetableEntry {
  id        String    @id @default(cuid())
  sectionId String
  section   Section   @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  periodId  String
  period    Period    @relation(fields: [periodId], references: [id])
  dayOfWeek DayOfWeek
  subjectId String
  subject   Subject   @relation(fields: [subjectId], references: [id])
  teacherId String
  teacher   User      @relation("EntryTeacher", fields: [teacherId], references: [id])

  @@unique([sectionId, periodId, dayOfWeek])
  @@unique([teacherId, periodId, dayOfWeek])
  @@index([periodId])
  @@index([subjectId])
  @@index([teacherId])
}

enum AttendanceStatus {
  present
  absent
  leave
}

// One session per section+day; AttendanceEdit (admin audit log) added in T-034.
model AttendanceSession {
  id            String   @id @default(cuid())
  sectionId     String
  section       Section  @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  date          DateTime @db.Date
  submittedById String
  submittedBy   User     @relation("AttendanceSubmitter", fields: [submittedById], references: [id])
  submittedAt   DateTime @default(now())
  updatedAt     DateTime @updatedAt

  entries AttendanceEntry[]
  edits   AttendanceEdit[]

  @@unique([sectionId, date])
  @@index([submittedById])
}

model AttendanceEntry {
  id        String            @id @default(cuid())
  sessionId String
  session   AttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  studentId String
  student   User              @relation("StudentAttendance", fields: [studentId], references: [id], onDelete: Cascade)
  status    AttendanceStatus

  @@unique([sessionId, studentId])
  @@index([studentId])
}

// T-034: admin audit log — one row per student status change made via the admin edit endpoint.
model AttendanceEdit {
  id         String            @id @default(cuid())
  sessionId  String
  session    AttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  studentId  String
  student    User              @relation("AttendanceEditedStudent", fields: [studentId], references: [id])
  fromStatus AttendanceStatus
  toStatus   AttendanceStatus
  editedById String
  editedBy   User              @relation("AttendanceEditedBy", fields: [editedById], references: [id])
  editedAt   DateTime          @default(now())

  @@index([sessionId])
  @@index([studentId])
  @@index([editedById])
}

/// A notice-board announcement. `classId` null means school-wide; otherwise only that class's students and their parents see it.
model Notice {
  id          String   @id @default(cuid())
  title       String
  description String
  classId     String?
  class       Class?   @relation(fields: [classId], references: [id], onDelete: Cascade)
  authorId    String?
  author      User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  // Snapshot so the byline survives the author's account being deleted.
  authorName  String
  authorRole  Role
  createdAt   DateTime @default(now())

  @@index([classId])
  @@index([createdAt])
}
