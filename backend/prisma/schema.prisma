// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  admin
  teacher
  student
  parent
}

model User {
  id             String               @id @default(cuid())
  name           String
  email          String               @unique
  passwordHash   String
  role           Role
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  teacher        Teacher?
  student        Student?
  refreshTokens  RefreshToken[]
  passwordResets PasswordResetToken[]
  notices        Notice[]

  attendanceSubmitted Attendance[]         @relation("AttendanceSubmittedBy")
  attendanceChanges   AttendanceAuditLog[] @relation("AttendanceChangedBy")
}

enum NoticeAudience {
  all
  admin
  teacher
  student
  parent
}

model Notice {
  id          String         @id @default(cuid())
  title       String
  description String
  audience    NoticeAudience @default(all)
  postedById  String
  postedBy    User           @relation(fields: [postedById], references: [id], onDelete: Restrict)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([audience, createdAt])
  @@index([postedById])
}

model RefreshToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  longLived Boolean   @default(false)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Student {
  id            String             @id @default(cuid())
  userId        String             @unique
  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  rollNumber    String             @unique
  sectionId     String?
  section       Section?           @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  gender        String?
  guardianName  String
  guardianPhone String
  dateOfBirth   DateTime?
  address       String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  attendance    AttendanceRecord[]
}

model Teacher {
  id             String         @id @default(cuid())
  userId         String         @unique
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  employeeId     String         @unique
  subject        String
  gender         String?
  phone          String?
  qualification  String?
  classSections  Section[]      @relation("ClassTeacher")
  subjectAssigns ClassSubject[]
  dateOfBirth    DateTime?
  address        String?
  joinedAt       DateTime?
  deletedAt      DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

model SchoolClass {
  id        String         @id @default(cuid())
  name      String         @unique
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  sections  Section[]
  subjects  ClassSubject[]
}

model Section {
  id             String      @id @default(cuid())
  name           String
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  classId        String
  schoolClass    SchoolClass @relation(fields: [classId], references: [id], onDelete: Cascade)
  classTeacherId String?

  teacher  Teacher?  @relation("ClassTeacher", fields: [classTeacherId], references: [id], onDelete: SetNull)
  students Student[]

  attendance        Attendance[]
  attendanceRecords AttendanceRecord[]

  @@unique([classId, name])
  @@index([classTeacherId])
}

model ClassSubject {
  id          String      @id @default(cuid())
  classId     String
  schoolClass SchoolClass @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject     String
  teacherId   String?
  teacher     Teacher?    @relation(fields: [teacherId], references: [id], onDelete: SetNull)

  @@unique([classId, subject])
  @@index([teacherId])
}

enum AttendanceStatus {
  present
  absent
  leave
}

model Attendance {
  id            String             @id @default(cuid())
  sectionId     String
  section       Section            @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  date          DateTime           @db.Date
  submittedById String
  submittedBy   User               @relation("AttendanceSubmittedBy", fields: [submittedById], references: [id], onDelete: Restrict)
  submittedAt   DateTime           @default(now())
  records       AttendanceRecord[]

  @@unique([sectionId, date])
  @@index([date])
}

model AttendanceRecord {
  id        String               @id @default(cuid())
  sessionId String
  session   Attendance           @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  studentId String
  student   Student              @relation(fields: [studentId], references: [id], onDelete: Cascade)
  sectionId String
  section   Section              @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  date      DateTime             @db.Date
  status    AttendanceStatus
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
  auditLogs AttendanceAuditLog[]

  @@unique([studentId, date])
  @@index([sectionId, date])
  @@index([studentId, date])
  @@index([sessionId])
}

model AttendanceAuditLog {
  id          String           @id @default(cuid())
  recordId    String
  record      AttendanceRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)
  oldStatus   AttendanceStatus
  newStatus   AttendanceStatus
  reason      String
  changedById String
  changedBy   User             @relation("AttendanceChangedBy", fields: [changedById], references: [id], onDelete: Restrict)
  createdAt   DateTime         @default(now())

  @@index([recordId])
  @@index([changedById])
}
